---
import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/500.css";
import "@fontsource/schibsted-grotesk/700.css";
import "@fontsource/schibsted-grotesk/800.css";
import "../styles/global.css";
import { copy } from "../content/copy";
import { site } from "../content/site";
import { buildGraph, serializeJsonLd, type ArticleData, type Crumb, type ServiceData } from "../scripts/schema";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** "article" voor blogartikelen, anders "website". */
  ogType?: "website" | "article";
  /** Broodkruimels na "Home", bijvoorbeeld [{ name: "Blog", path: "/blog/" }]. */
  breadcrumbs?: Crumb[];
  /** Gegevens voor BlogPosting structured data (alleen bij echte artikelen). */
  article?: ArticleData;
  /** Eigen Service-entiteit voor een dienstpagina (naast de algemene Service op de homepage). */
  service?: ServiceData;
  ogImageType?: string;
  ogImageSize?: [number, number];
  /** Zet structured data uit (alleen voor de 404-pagina). */
  schema?: boolean;
  /** Eigen deelbeeld (PNG, 1200x630) en alt-tekst; anders het standaardbeeld. */
  ogImage?: string;
  ogImageAlt?: string;
}

const { title = copy.meta.title, description = copy.meta.description, noindex = false, ogType = "website", breadcrumbs, article, service, ogImageType = "image/png", ogImageSize = [1200, 630], schema = true, ogImage: ogImagePath = copy.meta.ogImage, ogImageAlt = copy.meta.ogImageAlt } = Astro.props;
const base = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(ogImagePath, base).href;

// Structured data: één @graph met Organization, WebSite en WebPage (zie src/scripts/schema.ts).
const jsonLd = schema
  ? buildGraph({ base, path: Astro.url.pathname, title, description, isHome: Astro.url.pathname === "/", breadcrumbs, article, service })
  : undefined;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(ogImageSize[0])} />
    <meta property="og:image:height" content={String(ogImageSize[1])} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#F1F2F0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
    <script is:inline>
      // Beweging alleen als de bezoeker dat niet heeft uitgezet. Zonder deze class
      // toont de pagina overal de rustige eindstaat.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
