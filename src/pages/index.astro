---
import Base from "../layouts/Base.astro";
import IsoBlocks from "../components/IsoBlocks.astro";
import OldSite from "../components/OldSite.astro";
import NewSite from "../components/NewSite.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { copy } from "../content/copy";

const accents = ["var(--blue)", "#8A8A8A", "var(--orange)"];
const words = copy.hero.heading.split(" ");
const arrowRight = `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>`;
const arrow = `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>`;
---
<Base>
  <a class="skip" href="#main">Naar de inhoud</a>

  <!-- Vaste balk: verschijnt pas na de hero -->
  <header class="topbar" data-topbar>
    <a href="#top" class="topbar-logo"><img src="/images/logo-kobama.webp" alt="KOBAMA" width="480" height="125" /></a>
    <nav class="topbar-nav" aria-label="Hoofdmenu">
      {copy.nav.links.filter((l) => l.href !== "#contact").map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-sm" href={copy.contact}>{copy.nav.cta}</a>
  </header>

  <!-- 1. Hero: het logo zet zichzelf in elkaar -->
  <section class="hero" id="top" data-hero>
    <div class="hero-head wrap">
      <img class="hero-logo" src="/images/logo-kobama.webp" alt="KOBAMA" width="480" height="125" />
      <nav class="hero-nav" aria-label="Hoofdmenu">
        {copy.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    <div class="hero-body wrap">
      <div class="hero-copy">
        <h1 data-hero-h1>{words.map((w, i) => <><span class="w"><span>{w}</span></span>{i < words.length - 1 ? " " : ""}</>)}</h1>
        <p class="lead" data-hero-fade>{copy.hero.sub}</p>
        <p data-hero-fade><a class="btn" href={copy.contact}>{copy.hero.cta}</a></p>
      </div>
      <div class="hero-blocks" data-hero-blocks><IsoBlocks class="hero-iso" /></div>
    </div>
  </section>

  <main id="main">
    <!-- 2. Statement -->
    <section class="flow statement" data-theme="dark">
      <div class="wrap">
        <div class="statement-text">
          <p class="st1" data-reveal>{copy.statement.lines[0]}</p>
          <p class="st2" data-reveal>{copy.statement.lines[1]}</p>
        </div>
        <div class="proof">
          {copy.proof.map((p, i) => (
            <div class="proof-item" style={`--accent:${accents[i]}`}>
              <h2 class="h3">{p.title}</h2>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Transformatie: realistische vergelijking (verzonnen voorbeeldbedrijf, zie brief) -->
    <section class="flow transform" id="transformatie" data-theme="light" data-transform>
      <div class="transform-stage">
        <div class="wrap">
          <h2 class="h2">{copy.transformatie.heading}</h2>
          <div class="compare" data-compare>
            <div class="compare-pane before"><OldSite /></div>
            <div class="compare-pane after"><NewSite /></div>
            <span class="cmp-label l" data-cmp-after>{copy.transformatie.after.label}</span>
            <span class="cmp-label r" data-cmp-before>{copy.transformatie.before.label}</span>
            <div class="compare-line" data-compare-line aria-hidden="true"><span class="split-handle" set:html={arrowRight} /></div>
          </div>
          <p class="caption">{copy.transformatie.caption}</p>
        </div>
      </div>
    </section>

    <!-- 4. Werkwijze: het logo bouwt zich op -->
    <section class="flow werkwijze" id="werkwijze" data-theme="paper">
      <div class="wrap werk-grid">
        <div class="werk-visual"><IsoBlocks class="werk-iso" /></div>
        <div class="werk-steps">
          <h2 class="h2">{copy.werkwijze.heading}</h2>
          <ol class="steps">
            {copy.werkwijze.steps.map((s, i) => (
              <li class="step" data-step={i + 1}>
                <h3 class="h3 step-title">{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 5. Team -->
    <section class="flow team" id="team" data-theme="light">
      <div class="wrap">
        <h2 class="h2">{copy.people.heading}</h2>
        <div class="team-grid">
          {copy.people.members.map((m) => (
            <figure class="member" data-placeholder={m.isPlaceholder ? "bio" : undefined}>
              <img src={m.photo} alt={`Portret van ${m.name}`} width="900" height="1200" loading="lazy" decoding="async" />
              <figcaption>
                <h3 class="h3">{m.name}</h3>
                <p>{m.bio}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Afsluiting -->
    <section class="flow closing" id="contact" data-theme="orange">
      <div class="wrap">
        <h2 class="closing-h">{copy.closing.heading}</h2>
        <p class="lead">{copy.closing.priceLine}</p>
        <p><a class="btn btn-dark" href={copy.contact}>{copy.closing.cta}</a></p>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import "../scripts/motion.ts";
  </script>
</Base>
