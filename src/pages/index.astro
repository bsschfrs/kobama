---
// v4 — Hollands licht. White editorial with a cinematic layered hero: sky,
// floating site mockup, and a canal-facade foreground that lags on scroll and
// dissolves into the navy intro section below.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "../styles/reset.css";
import { copy } from "../content/copy";
import SiteMockup from "../components/SiteMockup.astro";
import LogoIntro from "../components/LogoIntro.astro";
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="preload" as="image" href="/images/hero-sky.webp" />
    <link rel="preload" as="image" href="/images/hero-facades.webp" />
    <!--
      THESIS: Calm reads as competence. One cinematic Amsterdam viewport, then
      extreme quiet — refusing the icon-grid landing page entirely.
      OWN-WORLD: White ground, near-black text, hairline rules, periwinkle
      #9399BB sky and #111A2B canal navy drawn straight from the photograph.
      No italics, no em dashes in copy. Plain, declarative sentences only.
      STORY: An SMB owner sees a site rise out of an Amsterdam canal, believes
      this studio makes things that look better than what they have, books a call.
      FIRST VIEWPORT: Headline left over open sky; the site mockup floats centre
      and passes behind the gable row as it rises; water dissolves into navy.
      FORM: User-chosen direction 4 of 5 ("Hollands licht"), extended with the
      layered fora.so-style scroll transition at the user's request.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md.
    -->
    <style>
      :root {
        --bg: #ffffff;
        --fg: #111111;
        --accent: #b0602f;
        --hairline: #d8d5cc;
        --muted: #767267;
        --navy: #111a2b;
        --navy-soft: #1b2740;
        --sky: #9399bb;
        --sky-pale: #b6b2cd;
      }
      html,
      body {
        background: var(--bg);
      }
      body {
        color: var(--fg);
        font-family: "Inter", system-ui, sans-serif;
        font-size: 15px;
        line-height: 24px;
        letter-spacing: -0.2px;
        overflow-x: hidden;
      }
      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: 40px;
      }
      @media (max-width: 640px) {
        .wrap {
          padding-inline: 24px;
        }
      }
      .measure {
        max-width: 520px;
      }
      h1,
      h2,
      h3 {
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      h1 {
        font-size: clamp(32px, 3.9vw, 54px);
        line-height: 1.06;
      }
      h2 {
        font-size: clamp(24px, 3.2vw, 40px);
        line-height: 1.15;
      }
      .statement-text {
        font-size: clamp(20px, 2.5vw, 31px);
        line-height: 1.45;
        font-weight: 400;
        letter-spacing: -0.025em;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        padding: 0 30px;
        border: 1px solid var(--fg);
        border-radius: 6px;
        color: var(--fg);
        font-size: 13px;
        font-weight: 500;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .btn-primary:hover,
      .btn-primary:focus-visible {
        background: var(--fg);
        color: #fff;
      }
      .btn-on-dark {
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
      }
      .btn-on-dark:hover,
      .btn-on-dark:focus-visible {
        background: #fff;
        color: var(--navy);
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Nav ---------- */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 60;
        border-bottom: 1px solid transparent;
        transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
      }
      .nav.is-solid {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(12px);
        border-bottom-color: var(--hairline);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 76px;
      }
      /* Magnetic nudge (JS, .brand-mark, driven by its own rAF spring — see
         magnetic-logo.ts) and the 3D flip (CSS, .brand-mark-img) live on
         different elements on purpose, so the two transforms never fight
         each other. No CSS transition on .brand-mark's transform: the spring
         script already owns that property every frame, including the
         overshoot on release, which a parallel CSS transition would only
         dampen. */
      .brand-mark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        perspective: 500px;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        font: inherit;
        color: inherit;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }
      .brand-mark-img {
        display: block;
        height: 24px;
        width: auto;
      }
      @keyframes brand-flip {
        to {
          transform: rotateY(360deg);
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        .brand-mark:hover .brand-mark-img {
          animation: brand-flip 0.9s cubic-bezier(0.4, 0.1, 0.2, 1);
        }
      }

      /* Menu toggle — a small hamburger that morphs into a close cross,
         next to the logo. Same mark, new job: it's the nav now. */
      .brand-toggle {
        position: relative;
        width: 14px;
        height: 10px;
        flex: none;
      }
      .brand-toggle-line {
        position: absolute;
        left: 0;
        width: 100%;
        height: 1.4px;
        background: var(--fg);
        transform-origin: center;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .brand-toggle-line:nth-child(1) {
        top: 0;
      }
      .brand-toggle-line:nth-child(2) {
        bottom: 0;
      }
      .brand-mark.is-open .brand-toggle-line:nth-child(1) {
        transform: translateY(4.3px) rotate(45deg);
      }
      .brand-mark.is-open .brand-toggle-line:nth-child(2) {
        transform: translateY(-4.3px) rotate(-45deg);
      }

      /* ---------- Nav menu ---------- */
      /* A panel that unfolds over the page from under the mark — not a
         full-width bar. Fixed full-viewport container so the backdrop can
         dim the page; the panel itself stays a compact card. */
      .nav-menu {
        position: fixed;
        inset: 0;
        z-index: 90;
        pointer-events: none;
      }
      .nav-menu.is-open {
        pointer-events: auto;
      }
      .nav-menu-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(17, 26, 43, 0.3);
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      .nav-menu.is-open .nav-menu-backdrop {
        opacity: 1;
        transition: opacity 0.5s ease;
      }
      .nav-menu-panel {
        position: absolute;
        top: 92px;
        left: 50%;
        width: min(380px, calc(100vw - 48px));
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 24px 60px -18px rgba(17, 17, 17, 0.32);
        padding: 10px 20px 20px;
        transform-origin: top center;
        clip-path: inset(0 0 100% 0 round 12px);
        opacity: 0;
        transform: translateX(-50%) scale(0.97);
        transition: clip-path 0.3s ease, opacity 0.22s ease, transform 0.3s ease;
      }
      .nav-menu.is-open .nav-menu-panel {
        clip-path: inset(0 0 0 0 round 12px);
        opacity: 1;
        transform: translateX(-50%) scale(1);
        transition: clip-path 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease,
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .nav-menu-list {
        display: flex;
        flex-direction: column;
      }
      .nav-menu-list li {
        border-bottom: 1px solid var(--hairline);
      }
      .nav-menu-list li:last-child {
        border-bottom: none;
      }
      .nav-menu-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 15px 2px;
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--fg);
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
      }
      .nav-menu-link:hover,
      .nav-menu-link:focus-visible {
        color: var(--accent);
      }
      .nav-menu-link-arrow {
        flex: none;
        color: currentColor;
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .nav-menu-link:hover .nav-menu-link-arrow,
      .nav-menu-link:focus-visible .nav-menu-link-arrow {
        opacity: 1;
        transform: translateX(0);
      }
      .nav-menu.is-open .nav-menu-link {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
          color 0.2s ease;
      }
      .nav-menu.is-open .nav-menu-list li:nth-child(1) .nav-menu-link {
        transition-delay: 0.1s;
      }
      .nav-menu.is-open .nav-menu-list li:nth-child(2) .nav-menu-link {
        transition-delay: 0.15s;
      }
      .nav-menu.is-open .nav-menu-list li:nth-child(3) .nav-menu-link {
        transition-delay: 0.2s;
      }
      .nav-menu.is-open .nav-menu-list li:nth-child(4) .nav-menu-link {
        transition-delay: 0.25s;
      }
      .nav-menu.is-open .nav-menu-list li:nth-child(5) .nav-menu-link {
        transition-delay: 0.3s;
      }
      .nav-menu-cta {
        margin-top: 14px;
        width: 100%;
        background: var(--fg);
        border-color: var(--fg);
        color: #fff;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease, color 0.2s ease,
          border-color 0.2s ease;
      }
      .nav-menu-cta:hover,
      .nav-menu-cta:focus-visible {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      .nav-menu.is-open .nav-menu-cta {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.34s,
          transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.34s, background 0.2s ease, color 0.2s ease,
          border-color 0.2s ease;
      }
      @media (max-width: 640px) {
        .nav-menu-panel {
          top: 84px;
          width: calc(100vw - 32px);
        }
      }
      body.nav-open {
        overflow: hidden;
      }

      /* ---------- Cinematic hero ---------- */
      .hero-scroll {
        position: relative;
        height: 220vh;
      }
      .hero-stage {
        position: sticky;
        top: 0;
        height: 100dvh;
        overflow: hidden;
        background: linear-gradient(to bottom, #a5a9c6 0%, var(--sky-pale) 46%, #8f93b4 72%, var(--navy) 100%);
      }

      .layer {
        position: absolute;
        inset: 0;
        will-change: transform;
      }

      /* Navy underlay: sits above the sky and below the foreground, so when the
         facades lag upward they uncover canal navy rather than lavender sky.
         Hidden behind the facades at rest, so it costs nothing visually. */
      .hero-stage::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 46vh;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(
          to bottom,
          rgba(17, 26, 43, 0) 0%,
          rgba(17, 26, 43, 0.65) 42%,
          var(--navy) 84%
        );
      }

      /* sky */
      .layer-sky {
        z-index: 1;
      }
      .layer-sky img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
      }

      /* headline block */
      /* Headline and mockup share one normal-flow column (not two
         separately-positioned absolute layers): the browser stacks and
         centers them, so there's no vh-based math to keep in sync across
         breakpoints. Each keeps its own data-layer for the scroll parallax. */
      .layer-content {
        z-index: 3;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: clamp(120px, 15vh, 190px);
        pointer-events: none;
      }
      .layer-content .wrap {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .hero-copy {
        pointer-events: auto;
        max-width: min(90vw, 620px);
        text-align: center;
      }
      .hero-copy h1 {
        color: #0d1424;
      }
      /* Desktop-only: bigger, slightly heavier heading with room to sit on
         one line. Mobile keeps its own smaller, bolder override below. */
      @media (min-width: 1024px) {
        .hero-copy {
          max-width: min(92vw, 1040px);
        }
        .hero-copy h1 {
          font-size: clamp(40px, 3.6vw, 62px);
          font-weight: 600;
          white-space: nowrap;
        }
      }
      .hero-copy p {
        margin-top: 20px;
        margin-inline: auto;
        max-width: 430px;
        font-size: 14px;
        line-height: 1.5;
        /* 5.2:1 on the #9399BB sky — #2c3348 measured 4.49 and missed AA */
        color: #232838;
      }
      /* --mockup-fs must always equal the holder's rendered width / 62 —
         that ratio is what keeps the mockup proportional. */
      .mockup-holder {
        pointer-events: auto;
        width: min(50vw, 460px);
        margin-top: 40px;
        --mockup-fs: calc(min(50vw, 460px) / 62);
      }
      @media (max-width: 900px) {
        .mockup-holder {
          width: min(64vw, 360px);
          --mockup-fs: calc(min(64vw, 360px) / 62);
          margin-top: 32px;
        }
      }
      @media (max-width: 640px) {
        .layer-content {
          /* min() keeps this from eating too much of a short viewport: caps
             against the facades layer's own top edge (46vh from the bottom
             at this tier) minus the room the copy block + gap + mockup need,
             instead of a fixed clamp ceiling tuned for one phone height. */
          padding-top: clamp(48px, min(12vh, 54vh - 280px), 150px);
        }
        .hero-copy h1 {
          font-size: 28px;
          font-weight: 700;
        }
        .hero-copy p {
          margin-top: 14px;
        }
        .mockup-holder {
          width: min(76vw, 300px);
          --mockup-fs: calc(min(76vw, 300px) / 62);
          margin-top: clamp(14px, 5vh, 40px);
        }
      }

      /* foreground facades + water */
      .layer-facades {
        z-index: 5;
        inset: auto 0 0 0;
        height: 54vh;
        pointer-events: none;
      }
      .layer-facades img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 12%;
      }
      /* water dissolving into the navy of the section below */
      .layer-facades::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(17, 26, 43, 0) 38%,
          rgba(17, 26, 43, 0.55) 62%,
          rgba(17, 26, 43, 0.92) 82%,
          var(--navy) 96%
        );
      }
      @media (max-width: 900px) {
        .layer-facades {
          height: 46vh;
        }
      }

      .scroll-hint {
        position: absolute;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        z-index: 6;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
      .scroll-hint-label {
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
      }
      .scroll-hint-track {
        position: relative;
        width: 1px;
        height: 28px;
        background: rgba(255, 255, 255, 0.25);
      }
      .scroll-hint-dot {
        position: absolute;
        left: 50%;
        top: 0;
        width: 5px;
        height: 5px;
        margin-left: -2px;
        border-radius: 50%;
        background: #fff;
        animation: scroll-hint-travel 1.8s ease-in-out infinite;
      }
      @keyframes scroll-hint-travel {
        0% {
          top: 0;
          opacity: 0;
        }
        15% {
          opacity: 1;
        }
        85% {
          opacity: 1;
        }
        100% {
          top: 22px;
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-hint-dot {
          animation: none;
          top: 10px;
          opacity: 0.8;
        }
      }

      /* ---------- Intro (navy) ---------- */
      .intro {
        background: var(--navy);
        color: rgba(255, 255, 255, 0.9);
        padding-block: clamp(90px, 16vh, 180px) clamp(120px, 20vh, 220px);
        position: relative;
      }
      .intro .statement-text {
        color: rgba(255, 255, 255, 0.28);
        transition: color 0.5s cubic-bezier(0.44, 0, 0.56, 1);
        max-width: 780px;
      }
      .intro.is-revealed .statement-text {
        color: #fff;
      }
      .intro .statement-text + .statement-text {
        margin-top: 26px;
      }
      .intro-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 32px;
        margin-top: clamp(56px, 9vh, 96px);
        padding-top: 34px;
        border-top: 1px solid rgba(255, 255, 255, 0.16);
      }
      .intro-meta h3 {
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        margin-bottom: 8px;
      }
      .intro-meta p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: -0.01em;
      }
      /* navy → white handoff, so the intro doesn't end on a hard edge
         either. A plain 2-stop alpha ramp reads as a visible seam here —
         linear alpha over a dark fill isn't perceived as linear
         brightness, it looks like it "jumps" through the middle. These
         stops approximate an eased curve instead (near-flat at both
         ends, doing most of the work in the middle third), and the taller
         band gives it room to actually read as gradual rather than a
         quick wash. */
      .intro::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 320px;
        background: linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.02) 20%,
          rgba(255, 255, 255, 0.1) 38%,
          rgba(255, 255, 255, 0.3) 53%,
          rgba(255, 255, 255, 0.6) 68%,
          rgba(255, 255, 255, 0.87) 84%,
          var(--bg) 100%
        );
        pointer-events: none;
      }

      section {
        padding-block: clamp(80px, 15vh, 150px);
      }

      /* ---------- Transformatie ---------- */
      /* Height here is scrub distance (progress 0→1) + the sticky stage's
         own height — a sticky element always needs its own height's worth
         of scroll to unpin and clear the viewport after the scrub
         finishes, no matter how tall this wrapper is. That's exactly why
         .transform-sticky is capped below instead of left at a full
         100dvh: shrinking that unpin distance is the only lever that
         actually shortens the "wipe already finished, still scrolling"
         stretch before Werkwijze — a taller wrapper here just delays it,
         doesn't remove it (scroll-transform.ts measures the sticky child's
         real height, so this stays correct whatever it resolves to).
         Scrub trimmed to 70vh and the cap to 720px (were 90vh/800px) to
         keep the whole section quick to get through — see the heading
         and spacing changes below for where that extra headroom came from. */
      .transform-wrap {
        height: calc(70vh + min(calc(100dvh - 92px), 720px));
        position: relative;
        --progress: 0;
      }
      .transform-sticky {
        position: sticky;
        /* top:0 pinned this flush with the viewport top — directly under
           the fixed nav (76px tall, z-index:60, no stacking context on
           this element to paint above it), so the heading was rendering
           hidden behind it the whole time it was pinned. 92px matches the
           nav-menu-panel's own "just under the nav" offset elsewhere in
           this file. The height formula subtracts that same 92px so the
           box still can't overflow past the viewport bottom on shorter
           screens — it's not just a flat 100dvh anymore. */
        top: 92px;
        height: min(calc(100dvh - 92px), 720px);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      /* .wrap has no explicit width — normally harmless, since a block
         box fills its container by default. But as a flex item here
         (.transform-sticky is display:flex) its margin-inline:auto
         becomes real auto cross-axis margins, and flexbox centers auto-
         margined items in their *content* size instead of stretching
         them — .transform-stage was rendering at roughly a third of its
         1080px max-width because of it. Same fix .layer-content .wrap
         already needed for the same reason. */
      .transform-sticky .wrap {
        width: 100%;
      }
      /* Now inside the pinned view, above the stage, instead of in normal
         flow before it — so it's still on screen for the whole wipe
         instead of having scrolled away before the pin even starts,
         same as the caption already was. Tightened margin (was 30px)
         since it now has to share the fixed sticky height with the stage
         and caption. */
      .transform-heading {
        margin-bottom: 12px;
      }
      .transform-stage {
        position: relative;
        width: 100%;
        /* 1000px, down from 1080 — barely visible, but combined with the
           92px top offset above, it's what keeps this fitting comfortably
           on ~800px-tall viewports (common with browser chrome eating
           into the screen) instead of just barely fitting on tall ones. */
        max-width: 1000px;
        margin-inline: auto;
        /* 16:9 instead of 16:10 — same visual width, less height, freeing
           up room for the heading without growing the sticky cap. */
        aspect-ratio: 16 / 9;
        border: 1px solid var(--fg);
        border-radius: 12px;
        overflow: hidden;
      }
      .transform-panel {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
      }
      .transform-panel.before {
        background: #f1efe9;
      }
      .transform-panel.after {
        background: #fff;
        border-left: 2px solid var(--accent);
        clip-path: inset(0 calc((1 - var(--progress)) * 100%) 0 0);
      }
      /* Nudges people to scroll rather than just glance at the static
         "before" state and move on — same dot-in-a-track motif as the
         hero's own scroll hint, recoloured for this light box instead of
         invented fresh. Reads --progress directly (inherited from
         .transform-wrap, which scroll-transform.ts already sets) so it
         fades out the moment scrolling actually starts, no separate JS. */
      .transform-hint {
        position: absolute;
        right: 20px;
        bottom: 20px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 8px;
        pointer-events: none;
        opacity: calc(1 - var(--progress, 0) * 8);
        transition: opacity 0.3s ease;
      }
      .transform-hint-label {
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .transform-hint-track {
        position: relative;
        width: 1px;
        height: 22px;
        background: var(--hairline);
      }
      .transform-hint-dot {
        position: absolute;
        left: 50%;
        top: 0;
        width: 4px;
        height: 4px;
        margin-left: -2px;
        border-radius: 50%;
        background: var(--accent);
        animation: transform-hint-travel 1.8s ease-in-out infinite;
      }
      @keyframes transform-hint-travel {
        0% {
          top: 0;
          opacity: 0;
        }
        15% {
          opacity: 1;
        }
        85% {
          opacity: 1;
        }
        100% {
          top: 17px;
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .transform-hint-dot {
          animation: none;
          top: 8px;
          opacity: 0.8;
        }
      }
      .transform-tag {
        font-size: 12px;
        border: 1px solid var(--fg);
        border-radius: 6px;
        padding: 5px 14px;
      }
      .transform-note {
        color: var(--muted);
        font-size: 12px;
      }
      .transform-caption {
        margin-top: 10px;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
      }

      /* ---------- Werkwijze ---------- */
      /* Scoped to just this boundary — the generic `section` rule below
         gives every section top+bottom padding, which stacked into a very
         wide gap specifically between the last step and "Wie het maakt."
         Halving it here only, rather than lowering the shared rule, keeps
         every other section-to-section gap on the page unchanged. */
      #werkwijze {
        padding-bottom: clamp(40px, 8vh, 80px);
      }
      /* Each step reveals on its own as it scrolls into view (reveal.ts
         observes every [data-reveal] element independently, so this needs
         no extra JS) — the hairline above it draws in first, left to
         right, then the content rises up underneath it. Two beats instead
         of one flat fade, and it reuses the hairline motif that's already
         the site's own structural language rather than inventing a new
         effect. */
      .step {
        position: relative;
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 28px;
        padding-block: 44px;
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
          transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
      }
      .step::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--hairline);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .step.is-revealed {
        opacity: 1;
        transform: translateY(0);
      }
      .step.is-revealed::before {
        transform: scaleX(1);
      }
      .step:last-child {
        border-bottom: 1px solid var(--hairline);
      }
      .step-number {
        font-size: 13px;
        color: var(--accent);
      }
      .step h3 {
        font-size: clamp(21px, 2.2vw, 28px);
        margin-bottom: 10px;
      }
      .step p {
        color: var(--muted);
        max-width: 560px;
      }
      .step-detail {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }
      .step-detail span {
        font-size: 12px;
        color: var(--muted);
        border: 1px solid var(--hairline);
        border-radius: 6px;
        padding: 5px 12px;
      }
      @media (max-width: 640px) {
        .step {
          grid-template-columns: 1fr;
          gap: 10px;
        }
      }

      /* ---------- Team ---------- */
      /* Pairs with #werkwijze's padding-bottom override above — same
         reasoning, just the other side of that one gap. */
      #team {
        padding-top: clamp(40px, 8vh, 80px);
      }
      /* Three individual founders now, not one shared portrait+bio block.
         Same wipe-then-text-follows idea as before, but each person's
         --stagger (set inline per card, see the .map() in the markup)
         offsets both their portrait and their text together, so the row
         reveals left to right instead of all three snapping in at once. */
      .people-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: clamp(28px, 5vw, 48px);
      }
      .person-portrait {
        aspect-ratio: 3 / 4;
        background: #f1efe9;
        border: 1px dashed var(--hairline);
        border-radius: 12px;
        clip-path: inset(0 0 100% 0);
        transition: clip-path 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--stagger, 0s);
      }
      .people-grid.is-revealed .person-portrait {
        clip-path: inset(0 0 0% 0);
      }
      .person-name {
        margin-top: 16px;
        font-size: 17px;
        font-weight: 500;
      }
      .person-bio {
        margin-top: 4px;
        color: var(--muted);
        font-size: 14px;
      }
      .person-name,
      .person-bio {
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--stagger, 0s) + 0.3s),
          transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--stagger, 0s) + 0.3s);
      }
      .people-grid.is-revealed .person-name,
      .people-grid.is-revealed .person-bio {
        opacity: 1;
        transform: translateY(0);
      }
      @media (max-width: 640px) {
        .people-grid {
          grid-template-columns: 1fr;
          max-width: 220px;
          margin-inline: auto;
          gap: 40px;
        }
      }

      /* ---------- Closing ---------- */
      /* The last word on the page gets the most typographic treatment
         rather than another slide: the heading settles into its normal
         tight tracking as it fades in (starts slightly splayed out), and
         the button arrives a beat after, distinct from every other
         reveal on this page. */
      .closing {
        text-align: center;
        border-top: 1px solid var(--hairline);
      }
      .closing h2 {
        margin-bottom: 30px;
        opacity: 0;
        letter-spacing: 0.06em;
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), letter-spacing 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .closing.is-revealed h2 {
        opacity: 1;
        letter-spacing: -0.03em;
      }
      .closing .btn-primary {
        opacity: 0;
        transform: translateY(12px);
        /* Keeps .btn-primary's own background/color hover transition
           alive — a full `transition: opacity, transform` here would
           silently replace that list and make the hover fill snap
           instantly instead of easing. */
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.25s,
          background 0.2s ease, color 0.2s ease;
      }
      .closing.is-revealed .btn-primary {
        opacity: 1;
        transform: translateY(0);
      }
      /* Reassurance note under the CTA — italic and a size down so it
         reads as a quiet aside, not a second headline. Trails in after
         the button (0.4s, later than the button's own 0.25s) so the
         order of arrival matches the order you'd actually read them. */
      .closing-note {
        margin-top: 14px;
        font-style: italic;
        font-size: 13px;
        color: var(--muted);
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s;
      }
      .closing.is-revealed .closing-note {
        opacity: 1;
        transform: translateY(0);
      }

      footer {
        border-top: 1px solid var(--hairline);
        padding-block: 44px;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--muted);
        font-size: 13px;
      }

      /* ---------- Custom cursor ---------- */
      /* Only switched on by cursor.ts once it confirms a fine pointer and no
         reduced-motion preference, so a script failure just leaves the
         native cursor visible instead of hiding it with nothing to replace.
         :global() on the a/button parts: without it, Astro's scoped-styles
         compiler appends THIS file's own data-astro-cid attribute to every
         simple selector in the rule — including the descendant `a`/`button`
         — so it silently stops matching links/buttons rendered by a child
         component (like SiteMockup.astro's own scope id), leaving the
         native pointer cursor showing through on those. */
      .has-custom-cursor,
      .has-custom-cursor :global(a),
      .has-custom-cursor :global(button) {
        cursor: none;
      }
      .cursor-dot,
      .cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        opacity: 0;
        pointer-events: none;
        z-index: 100;
        border-radius: 50%;
        will-change: transform;
      }
      .cursor-dot {
        width: 8px;
        height: 8px;
        background: #fff;
        mix-blend-mode: difference;
        transition: transform 0.15s ease-out, opacity 0.2s ease;
      }
      .cursor-ring {
        width: 38px;
        height: 38px;
        border: 1px solid #fff;
        mix-blend-mode: difference;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s ease;
      }
      .cursor-arrow {
        width: 13px;
        height: 9px;
        color: #fff;
        mix-blend-mode: difference;
        opacity: 0;
        transform: scale(0.6);
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .cursor-ring.is-hover .cursor-arrow {
        opacity: 1;
        transform: scale(1);
      }
      @media (pointer: coarse) {
        .cursor-dot,
        .cursor-ring {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <LogoIntro />
    <nav class="nav" data-nav>
      <div class="wrap nav-inner">
        <button
          type="button"
          class="brand-mark"
          data-magnetic
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label={`${copy.nav.brand} menu openen`}
        >
          <img
            src="/images/logo-kobama.webp"
            alt=""
            class="brand-mark-img"
            width="480"
            height="125"
          />
          <span class="brand-toggle" aria-hidden="true">
            <span class="brand-toggle-line"></span>
            <span class="brand-toggle-line"></span>
          </span>
        </button>
      </div>

      <div class="nav-menu" id="site-menu" data-nav-menu aria-hidden="true">
        <div class="nav-menu-backdrop" data-nav-backdrop></div>
        <div class="nav-menu-panel">
          <ul class="nav-menu-list">
            {copy.nav.links.map((link) => (
              <li>
                <a href={link.href} class="nav-menu-link" data-nav-link>
                  <span>{link.label}</span>
                  <svg
                    class="nav-menu-link-arrow"
                    width="14"
                    height="10"
                    viewBox="0 0 14 10"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M0.5 5H13M13 5L9 1M13 5L9 9"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
          <a class="btn-primary nav-menu-cta" href="mailto:kobama.info@gmail.com" data-nav-link>
            {copy.nav.cta}
          </a>
        </div>
      </div>
    </nav>

    <header class="hero-scroll" data-hero-scroll>
      <div class="hero-stage" data-hero-stage>
        <div class="layer layer-sky" data-layer="sky">
          <img src="/images/hero-sky.webp" alt="" width="1080" height="1400" fetchpriority="high" />
        </div>

        <div class="layer layer-content">
          <div class="wrap">
            <div class="hero-copy" data-layer="copy">
              <h1>{copy.hero.heading}</h1>
              <p>{copy.hero.sub}</p>
            </div>
            <div class="mockup-holder" data-layer="mockup">
              <SiteMockup />
            </div>
          </div>
        </div>

        <div class="layer layer-facades" data-layer="facades">
          <img src="/images/hero-facades.webp" alt="" width="1080" height="690" fetchpriority="high" />
        </div>

        <div class="scroll-hint" data-hero-hint>
          <span class="scroll-hint-label">Scroll</span>
          <span class="scroll-hint-track" aria-hidden="true">
            <span class="scroll-hint-dot"></span>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="intro" data-reveal>
        <div class="wrap">
          <p class="statement-text">
            KOBAMA is een klein team dat elk project zelf van begin tot eind doet.
          </p>
          <p class="statement-text">
            Geen sjablonen, geen tussenlagen: één site, gebouwd door de mensen die hem ook
            opleveren.
          </p>

          <div class="intro-meta">
            <div>
              <h3>Eén aanspreekpunt</h3>
              <p>Je praat met de mensen die het werk doen, niet met een accountmanager.</p>
            </div>
            <div>
              <h3>Vaste doorlooptijd</h3>
              <p>Je weet vooraf wanneer je site live gaat, en dat verschuift niet stilletjes.</p>
            </div>
            <div>
              <h3>Klaar bij oplevering</h3>
              <p>Hosting, onderhoud, vindbaarheid en snelheid staan goed op dag één.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="transformatie">
        <div class="transform-wrap" data-scroll-transform>
          <div class="transform-sticky">
            <div class="wrap">
              <h2 class="transform-heading">{copy.transformatie.heading}</h2>
              <div class="transform-stage">
                <div class="transform-panel before">
                  <span class="transform-tag">{copy.transformatie.before.label}</span>
                  <span class="transform-note">{copy.transformatie.before.placeholderNote}</span>
                </div>
                <div class="transform-panel after">
                  <span class="transform-tag">{copy.transformatie.after.label}</span>
                  <span class="transform-note">{copy.transformatie.after.placeholderNote}</span>
                </div>
                <div class="transform-hint" aria-hidden="true">
                  <span class="transform-hint-label">Scroll</span>
                  <span class="transform-hint-track">
                    <span class="transform-hint-dot"></span>
                  </span>
                </div>
              </div>
              <p class="transform-caption">{copy.transformatie.caption}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="werkwijze">
        <div class="wrap">
          <h2 style="margin-bottom: 20px;">{copy.werkwijze.heading}</h2>
          {copy.werkwijze.steps.map((step, i) => (
            <div class="step" data-reveal>
              <span class="step-number">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {i === 2 && (
                  <div class="step-detail">
                    <span>Hosting</span>
                    <span>Onderhoud</span>
                    <span>Vindbaarheid</span>
                    <span>Laadsnelheid</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="team">
        <div class="wrap">
          <h2 style="margin-bottom: 36px;">{copy.people.heading}</h2>
          <div class="people-grid" data-reveal>
            {copy.people.members.map((person, i) => (
              <div class="person" style={`--stagger: ${i * 0.12}s`}>
                <div
                  class="person-portrait"
                  role="img"
                  aria-label={`Portret van ${person.name} volgt`}
                ></div>
                <p class="person-name">{person.name}</p>
                <p class="person-bio">{person.bio}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="closing" id="contact" data-reveal>
        <div class="wrap">
          <h2>{copy.closing.heading}</h2>
          <a class="btn-primary" href="mailto:kobama.info@gmail.com">{copy.closing.cta}</a>
          <p class="closing-note">{copy.closing.priceLine}</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>{copy.footer.brand}, {copy.footer.city}</span>
        <a href="mailto:kobama.info@gmail.com">{copy.footer.cta}</a>
      </div>
    </footer>

    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true">
      <svg class="cursor-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0.5 5H13M13 5L9 1M13 5L9 9"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>

    <script>
      import { initScrollTransform } from "../scripts/scroll-transform";
      import { initReveal } from "../scripts/reveal";
      import { initCinematicHero } from "../scripts/hero-cinematic";
      import { initCustomCursor } from "../scripts/cursor";
      import { initMagneticLogo } from "../scripts/magnetic-logo";
      import { initNavMenu } from "../scripts/nav-menu";
      import { initMockupTilt } from "../scripts/mockup-tilt";
      import { initMockupMobileReveal } from "../scripts/mockup-mobile-reveal";
      import { initLogoIntro } from "../scripts/logo-intro";
      initLogoIntro();
      initCinematicHero();
      initScrollTransform();
      initReveal();
      initCustomCursor();
      initMagneticLogo();
      initNavMenu();
      initMockupTilt();
      initMockupMobileReveal();
    </script>
  </body>
</html>
