---
// v4 — Hollands licht. White editorial with a cinematic layered hero: sky,
// floating site mockup, and a canal-facade foreground that lags on scroll and
// dissolves into the navy intro section below.
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/source-serif-4/400-italic.css";
import "../styles/reset.css";
import { copy } from "../content/copy";
import SiteMockup from "../components/SiteMockup.astro";

const logoPlaceholders = Array.from({ length: 5 }, (_, i) => i);
---

<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="preload" as="image" href="/images/hero-sky.webp" />
    <link rel="preload" as="image" href="/images/hero-facades.webp" />
    <!--
      THESIS: Calm reads as competence. One cinematic Amsterdam viewport, then
      extreme quiet — refusing the icon-grid landing page entirely.
      OWN-WORLD: White ground, near-black text, hairline rules, periwinkle
      #9399BB sky and #111A2B canal navy drawn straight from the photograph,
      one Source Serif 4 italic word as the only ornament.
      STORY: An SMB owner sees a site rise out of an Amsterdam canal, believes
      this studio makes things that look better than what they have, books a call.
      FIRST VIEWPORT: Headline left over open sky; the site mockup floats centre
      and passes behind the gable row as it rises; water dissolves into navy.
      FORM: User-chosen direction 4 of 5 ("Hollands licht"), extended with the
      layered fora.so-style scroll transition at the user's request.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md.
    -->
    <style>
      :root {
        --bg: #ffffff;
        --fg: #111111;
        --accent: #b0602f;
        --hairline: #d8d5cc;
        --muted: #767267;
        --navy: #111a2b;
        --navy-soft: #1b2740;
        --sky: #9399bb;
        --sky-pale: #b6b2cd;
      }
      html,
      body {
        background: var(--bg);
      }
      body {
        color: var(--fg);
        font-family: "Inter", system-ui, sans-serif;
        font-size: 15px;
        line-height: 24px;
        letter-spacing: -0.2px;
        overflow-x: hidden;
      }
      em {
        font-family: "Source Serif 4", serif;
        font-style: italic;
        font-weight: 400;
      }
      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: 40px;
      }
      @media (max-width: 640px) {
        .wrap {
          padding-inline: 24px;
        }
      }
      .measure {
        max-width: 520px;
      }
      h1,
      h2,
      h3 {
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      h1 {
        font-size: clamp(32px, 3.9vw, 54px);
        line-height: 1.06;
      }
      h2 {
        font-size: clamp(24px, 3.2vw, 40px);
        line-height: 1.15;
      }
      .statement-text {
        font-size: clamp(20px, 2.5vw, 31px);
        line-height: 1.45;
        font-weight: 400;
        letter-spacing: -0.025em;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 48px;
        padding: 0 30px;
        border: 1px solid var(--fg);
        border-radius: 6px;
        color: var(--fg);
        font-size: 13px;
        font-weight: 500;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .btn-primary:hover,
      .btn-primary:focus-visible {
        background: var(--fg);
        color: #fff;
      }
      .btn-on-dark {
        border-color: rgba(255, 255, 255, 0.55);
        color: #fff;
      }
      .btn-on-dark:hover,
      .btn-on-dark:focus-visible {
        background: #fff;
        color: var(--navy);
      }
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---------- Nav ---------- */
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 60;
        border-bottom: 1px solid transparent;
        transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
      }
      .nav.is-solid {
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(12px);
        border-bottom-color: var(--hairline);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 76px;
      }
      /* Magnetic nudge (JS, .brand-mark) and the 3D flip (CSS, .brand-mark-img)
         live on different elements on purpose, so the two transforms never
         fight each other. */
      .brand-mark {
        display: inline-block;
        perspective: 500px;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .brand-mark-img {
        display: block;
        height: 24px;
        width: auto;
      }
      @keyframes brand-flip {
        to {
          transform: rotateY(360deg);
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        .brand-mark:hover .brand-mark-img {
          animation: brand-flip 0.9s cubic-bezier(0.4, 0.1, 0.2, 1);
        }
      }

      /* ---------- Cinematic hero ---------- */
      .hero-scroll {
        position: relative;
        height: 220vh;
      }
      .hero-stage {
        position: sticky;
        top: 0;
        height: 100dvh;
        overflow: hidden;
        background: linear-gradient(to bottom, #a5a9c6 0%, var(--sky-pale) 46%, #8f93b4 72%, var(--navy) 100%);
      }

      .layer {
        position: absolute;
        inset: 0;
        will-change: transform;
      }

      /* Navy underlay: sits above the sky and below the foreground, so when the
         facades lag upward they uncover canal navy rather than lavender sky.
         Hidden behind the facades at rest, so it costs nothing visually. */
      .hero-stage::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 46vh;
        z-index: 2;
        pointer-events: none;
        background: linear-gradient(
          to bottom,
          rgba(17, 26, 43, 0) 0%,
          rgba(17, 26, 43, 0.65) 42%,
          var(--navy) 84%
        );
      }

      /* sky */
      .layer-sky {
        z-index: 1;
      }
      .layer-sky img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
      }

      /* headline block */
      /* Headline and mockup share one normal-flow column (not two
         separately-positioned absolute layers): the browser stacks and
         centers them, so there's no vh-based math to keep in sync across
         breakpoints. Each keeps its own data-layer for the scroll parallax. */
      .layer-content {
        z-index: 3;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: clamp(120px, 15vh, 190px);
        pointer-events: none;
      }
      .layer-content .wrap {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .hero-copy {
        pointer-events: auto;
        max-width: min(90vw, 620px);
        text-align: center;
      }
      .hero-copy h1 {
        color: #0d1424;
      }
      /* Desktop-only: bigger, slightly heavier heading with room to sit on
         one line. Mobile keeps its own smaller, bolder override below. */
      @media (min-width: 1024px) {
        .hero-copy {
          max-width: min(92vw, 1040px);
        }
        .hero-copy h1 {
          font-size: clamp(40px, 3.6vw, 62px);
          font-weight: 600;
          white-space: nowrap;
        }
      }
      .hero-copy p {
        margin-top: 20px;
        margin-inline: auto;
        max-width: 430px;
        font-size: 14px;
        line-height: 1.5;
        /* 5.2:1 on the #9399BB sky — #2c3348 measured 4.49 and missed AA */
        color: #232838;
      }
      /* --mockup-fs must always equal the holder's rendered width / 62 —
         that ratio is what keeps the mockup proportional. */
      .mockup-holder {
        width: min(50vw, 460px);
        margin-top: 40px;
        --mockup-fs: calc(min(50vw, 460px) / 62);
      }
      @media (max-width: 900px) {
        .mockup-holder {
          width: min(64vw, 360px);
          --mockup-fs: calc(min(64vw, 360px) / 62);
          margin-top: 32px;
        }
      }
      @media (max-width: 640px) {
        .layer-content {
          /* min() keeps this from eating too much of a short viewport: caps
             against the facades layer's own top edge (46vh from the bottom
             at this tier) minus the room the copy block + gap + mockup need,
             instead of a fixed clamp ceiling tuned for one phone height. */
          padding-top: clamp(48px, min(12vh, 54vh - 280px), 150px);
        }
        .hero-copy h1 {
          font-size: 28px;
          font-weight: 700;
        }
        .hero-copy p {
          margin-top: 14px;
        }
        .mockup-holder {
          width: min(76vw, 300px);
          --mockup-fs: calc(min(76vw, 300px) / 62);
          margin-top: clamp(14px, 5vh, 40px);
        }
      }

      /* foreground facades + water */
      .layer-facades {
        z-index: 5;
        inset: auto 0 0 0;
        height: 54vh;
        pointer-events: none;
      }
      .layer-facades img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 12%;
      }
      /* water dissolving into the navy of the section below */
      .layer-facades::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to bottom,
          rgba(17, 26, 43, 0) 38%,
          rgba(17, 26, 43, 0.55) 62%,
          rgba(17, 26, 43, 0.92) 82%,
          var(--navy) 96%
        );
      }
      @media (max-width: 900px) {
        .layer-facades {
          height: 46vh;
        }
      }

      .scroll-hint {
        position: absolute;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        z-index: 6;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
      }
      .scroll-hint-label {
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
      }
      .scroll-hint-track {
        position: relative;
        width: 1px;
        height: 28px;
        background: rgba(255, 255, 255, 0.25);
      }
      .scroll-hint-dot {
        position: absolute;
        left: 50%;
        top: 0;
        width: 5px;
        height: 5px;
        margin-left: -2px;
        border-radius: 50%;
        background: #fff;
        animation: scroll-hint-travel 1.8s ease-in-out infinite;
      }
      @keyframes scroll-hint-travel {
        0% {
          top: 0;
          opacity: 0;
        }
        15% {
          opacity: 1;
        }
        85% {
          opacity: 1;
        }
        100% {
          top: 22px;
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-hint-dot {
          animation: none;
          top: 10px;
          opacity: 0.8;
        }
      }

      /* ---------- Intro (navy) ---------- */
      .intro {
        background: var(--navy);
        color: rgba(255, 255, 255, 0.9);
        padding-block: clamp(90px, 16vh, 180px) clamp(120px, 20vh, 220px);
        position: relative;
      }
      .intro .statement-text {
        color: rgba(255, 255, 255, 0.28);
        transition: color 0.5s cubic-bezier(0.44, 0, 0.56, 1);
        max-width: 780px;
      }
      .intro.is-revealed .statement-text {
        color: #fff;
      }
      .intro .statement-text + .statement-text {
        margin-top: 26px;
      }
      .intro-meta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 32px;
        margin-top: clamp(56px, 9vh, 96px);
        padding-top: 34px;
        border-top: 1px solid rgba(255, 255, 255, 0.16);
      }
      .intro-meta h3 {
        font-size: 15px;
        font-weight: 500;
        color: #fff;
        margin-bottom: 8px;
      }
      .intro-meta p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        letter-spacing: -0.01em;
      }
      /* navy → white handoff, so the intro doesn't end on a hard edge either */
      .intro::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 140px;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), var(--bg));
        pointer-events: none;
      }

      /* ---------- Logos ---------- */
      .logos {
        display: flex;
        gap: clamp(24px, 4vw, 56px);
        align-items: center;
        flex-wrap: wrap;
        padding-block: 40px;
        border-bottom: 1px solid var(--hairline);
      }
      .logos-label {
        font-size: 12px;
        color: var(--muted);
        width: 100%;
        margin-bottom: 4px;
      }
      .logo-chip {
        width: 92px;
        height: 26px;
        background: var(--hairline);
        opacity: 0.65;
      }

      section {
        padding-block: clamp(80px, 15vh, 150px);
      }

      /* ---------- Transformatie ---------- */
      .transform-wrap {
        height: 250vh;
        position: relative;
        --progress: 0;
      }
      .transform-sticky {
        position: sticky;
        top: 0;
        height: 100dvh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .transform-heading {
        margin-bottom: 30px;
      }
      .transform-stage {
        position: relative;
        width: 100%;
        max-width: 1080px;
        margin-inline: auto;
        aspect-ratio: 16 / 10;
        border: 1px solid var(--fg);
        overflow: hidden;
      }
      .transform-panel {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
      }
      .transform-panel.before {
        background: #f1efe9;
      }
      .transform-panel.after {
        background: #fff;
        border-left: 2px solid var(--accent);
        clip-path: inset(0 calc((1 - var(--progress)) * 100%) 0 0);
      }
      .transform-tag {
        font-size: 12px;
        border: 1px solid var(--fg);
        padding: 5px 14px;
      }
      .transform-note {
        color: var(--muted);
        font-size: 12px;
      }
      .transform-caption {
        margin-top: 20px;
        text-align: center;
        color: var(--muted);
        font-size: 14px;
      }

      /* ---------- Werkwijze ---------- */
      .step {
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 28px;
        padding-block: 44px;
        border-top: 1px solid var(--hairline);
      }
      .step:last-child {
        border-bottom: 1px solid var(--hairline);
      }
      .step-number {
        font-size: 13px;
        color: var(--accent);
      }
      .step h3 {
        font-size: clamp(21px, 2.2vw, 28px);
        margin-bottom: 10px;
      }
      .step p {
        color: var(--muted);
        max-width: 560px;
      }
      .step-detail {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }
      .step-detail span {
        font-size: 12px;
        color: var(--muted);
        border: 1px solid var(--hairline);
        padding: 5px 12px;
      }
      @media (max-width: 640px) {
        .step {
          grid-template-columns: 1fr;
          gap: 10px;
        }
      }

      /* ---------- Werk ---------- */
      .case {
        border: 1px dashed var(--hairline);
        padding: clamp(28px, 5vw, 56px);
        min-height: 42vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }
      .case + .case {
        margin-top: 28px;
      }
      .case h3 {
        font-size: clamp(21px, 2.2vw, 28px);
        margin-bottom: 10px;
      }
      .case p {
        color: var(--muted);
        max-width: 560px;
      }
      .case p + p {
        margin-top: 6px;
      }

      /* ---------- Team ---------- */
      .people-grid {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: clamp(28px, 5vw, 56px);
        align-items: start;
      }
      .portrait {
        aspect-ratio: 3 / 4;
        background: #f1efe9;
        border: 1px dashed var(--hairline);
      }
      .people-grid p {
        color: var(--muted);
        max-width: 560px;
      }
      .price-line {
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid var(--hairline);
        color: var(--fg);
        font-size: 15px;
      }
      @media (max-width: 640px) {
        .people-grid {
          grid-template-columns: 1fr;
        }
        .portrait {
          max-width: 170px;
        }
      }

      /* ---------- Closing ---------- */
      .closing {
        text-align: center;
        border-top: 1px solid var(--hairline);
      }
      .closing h2 {
        margin-bottom: 30px;
      }

      footer {
        border-top: 1px solid var(--hairline);
        padding-block: 44px;
      }
      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        color: var(--muted);
        font-size: 13px;
      }

      /* ---------- Custom cursor ---------- */
      /* Only switched on by cursor.ts once it confirms a fine pointer and no
         reduced-motion preference, so a script failure just leaves the
         native cursor visible instead of hiding it with nothing to replace. */
      .has-custom-cursor,
      .has-custom-cursor a,
      .has-custom-cursor button {
        cursor: none;
      }
      .cursor-dot,
      .cursor-ring {
        position: fixed;
        top: 0;
        left: 0;
        opacity: 0;
        pointer-events: none;
        z-index: 100;
        border-radius: 50%;
        will-change: transform;
      }
      .cursor-dot {
        width: 8px;
        height: 8px;
        background: #fff;
        mix-blend-mode: difference;
        transition: transform 0.15s ease-out, opacity 0.2s ease;
      }
      .cursor-ring {
        width: 38px;
        height: 38px;
        border: 1px solid #fff;
        mix-blend-mode: difference;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.2s ease;
      }
      .cursor-arrow {
        width: 13px;
        height: 9px;
        color: #fff;
        mix-blend-mode: difference;
        opacity: 0;
        transform: scale(0.6);
        transition: opacity 0.2s ease, transform 0.2s ease;
      }
      .cursor-ring.is-hover .cursor-arrow {
        opacity: 1;
        transform: scale(1);
      }
      @media (pointer: coarse) {
        .cursor-dot,
        .cursor-ring {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav" data-nav>
      <div class="wrap nav-inner">
        <a href="#" class="brand-mark" data-magnetic aria-label={copy.nav.brand}>
          <img
            src="/images/logo-kobama.webp"
            alt={copy.nav.brand}
            class="brand-mark-img"
            width="480"
            height="125"
          />
        </a>
      </div>
    </nav>

    <header class="hero-scroll" data-hero-scroll>
      <div class="hero-stage" data-hero-stage>
        <div class="layer layer-sky" data-layer="sky">
          <img src="/images/hero-sky.webp" alt="" width="1080" height="1400" fetchpriority="high" />
        </div>

        <div class="layer layer-content">
          <div class="wrap">
            <div class="hero-copy" data-layer="copy">
              <h1>{copy.hero.heading}</h1>
              <p>{copy.hero.sub}</p>
            </div>
            <div class="mockup-holder" data-layer="mockup">
              <SiteMockup />
            </div>
          </div>
        </div>

        <div class="layer layer-facades" data-layer="facades">
          <img src="/images/hero-facades.webp" alt="" width="1080" height="690" fetchpriority="high" />
        </div>

        <div class="scroll-hint" data-hero-hint>
          <span class="scroll-hint-label">Scroll</span>
          <span class="scroll-hint-track" aria-hidden="true">
            <span class="scroll-hint-dot"></span>
          </span>
        </div>
      </div>
    </header>

    <main>
      <section class="intro" data-reveal>
        <div class="wrap">
          <p class="statement-text">
            KOBAMA is een klein team dat elk project <em>zelf</em> van begin tot eind doet.
          </p>
          <p class="statement-text">
            Geen sjablonen, geen tussenlagen — één site, gebouwd door de mensen die hem ook
            opleveren.
          </p>

          <div class="intro-meta">
            <div>
              <h3>Eén aanspreekpunt</h3>
              <p>Je praat met de mensen die het werk doen, niet met een accountmanager.</p>
            </div>
            <div>
              <h3>Vaste doorlooptijd</h3>
              <p>Je weet vooraf wanneer je site live gaat, en dat verschuift niet stilletjes.</p>
            </div>
            <div>
              <h3>Klaar bij oplevering</h3>
              <p>Hosting, onderhoud, vindbaarheid en snelheid staan goed op dag één.</p>
            </div>
          </div>
        </div>
      </section>

      <div class="wrap">
        <div class="logos">
          <span class="logos-label">Gewerkt voor — logo's volgen zodra de eerste projecten zijn opgeleverd</span>
          {logoPlaceholders.map(() => (
            <div class="logo-chip" role="img" aria-label="Klantlogo volgt"></div>
          ))}
        </div>
      </div>

      <section id="transformatie">
        <div class="wrap">
          <h2 class="transform-heading">{copy.transformatie.heading}</h2>
        </div>
        <div class="transform-wrap" data-scroll-transform>
          <div class="transform-sticky">
            <div class="wrap">
              <div class="transform-stage">
                <div class="transform-panel before">
                  <span class="transform-tag">{copy.transformatie.before.label}</span>
                  <span class="transform-note">{copy.transformatie.before.placeholderNote}</span>
                </div>
                <div class="transform-panel after">
                  <span class="transform-tag">{copy.transformatie.after.label}</span>
                  <span class="transform-note">{copy.transformatie.after.placeholderNote}</span>
                </div>
              </div>
              <p class="transform-caption">{copy.transformatie.caption}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="werkwijze">
        <div class="wrap">
          <h2 style="margin-bottom: 20px;">{copy.werkwijze.heading}</h2>
          {copy.werkwijze.steps.map((step, i) => (
            <div class="step">
              <span class="step-number">{step.number}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                {i === 2 && (
                  <div class="step-detail">
                    <span>Hosting</span>
                    <span>Onderhoud</span>
                    <span>Vindbaarheid</span>
                    <span>Laadsnelheid</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section id="werk">
        <div class="wrap">
          <h2 style="margin-bottom: 36px;">{copy.work.heading}</h2>
          {copy.work.cases.map((c) => (
            <div class="case">
              <h3>{c.name}</h3>
              <p>{c.problem}</p>
              <p>{c.outcome}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="team">
        <div class="wrap">
          <h2 style="margin-bottom: 36px;">{copy.people.heading}</h2>
          <div class="people-grid">
            <div class="portrait" role="img" aria-label="Portret volgt"></div>
            <div>
              <p>{copy.people.bio}</p>
              <p class="price-line">{copy.people.priceLine}</p>
            </div>
          </div>
        </div>
      </section>

      <section class="closing" id="contact">
        <div class="wrap">
          <h2>{copy.closing.heading}</h2>
          <a class="btn-primary" href="mailto:hallo@kobama.nl">{copy.closing.cta}</a>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-inner">
        <span>{copy.footer.brand} — {copy.footer.city}</span>
        <a href="mailto:hallo@kobama.nl">{copy.footer.cta}</a>
      </div>
    </footer>

    <div class="cursor-dot" data-cursor-dot aria-hidden="true"></div>
    <div class="cursor-ring" data-cursor-ring aria-hidden="true">
      <svg class="cursor-arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M0.5 5H13M13 5L9 1M13 5L9 9"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </div>

    <script>
      import { initScrollTransform } from "../scripts/scroll-transform";
      import { initReveal } from "../scripts/reveal";
      import { initCinematicHero } from "../scripts/hero-cinematic";
      import { initCustomCursor } from "../scripts/cursor";
      import { initMagneticLogo } from "../scripts/magnetic-logo";
      initCinematicHero();
      initScrollTransform();
      initReveal();
      initCustomCursor();
      initMagneticLogo();
    </script>
  </body>
</html>
