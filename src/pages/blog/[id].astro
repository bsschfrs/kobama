---
// Eén blogartikel. Een artikel met `placeholder: true` is zichtbaar gemarkeerd
// (data-placeholder) zodat `npm run qa -- --launch` faalt tot het echt geschreven is.
// Echte artikelen krijgen een byline van een founder en BlogPosting structured data
// (Google Article-richtlijnen: auteur met url, datePublished en dateModified).
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BlogLinks from "../../components/BlogLinks.astro";
import { copy } from "../../content/copy";
import { formatDate, formatDateTime, getPosts, isScheduled } from "../../scripts/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, author: authorId, placeholder, image, imageAlt, seoTitle, seoDescription, breadcrumb } = post.data;
const imagePng = image?.replace(/\.svg$/, ".png");
const author = copy.people.members.find((m) => m.id === authorId);
const iso = (d: Date) => d.toISOString().slice(0, 10);

const article = !placeholder && author && date
  ? {
      headline: title,
      description,
      authorName: author.name,
      authorUrl: author.linkedin,
      datePublished: date,
      dateModified: updated,
      imagePath: imagePng ?? copy.meta.ogImage,
    }
  : undefined;
---
<Base title={seoTitle ?? `${title} | KOBAMA`} description={seoDescription ?? description} ogType={placeholder ? "website" : "article"} breadcrumbs={[{ name: "Blog", path: "/blog/" }, { name: breadcrumb ?? title, path: Astro.url.pathname }]} article={article} ogImage={imagePng} ogImageAlt={imageAlt}>
  <a class="skip" href="#main">Naar de inhoud</a>
  <PageHeader />
  <main id="main" class="wrap prose blog-post">
    <p class="blog-back"><a href="/blog/">{copy.blog.back}</a></p>
    {isScheduled(post) && date && <p class="blog-scheduled">{copy.blog.scheduled} {formatDateTime(date)}</p>}
    <article data-placeholder={placeholder ? `blog/${post.id}` : undefined}>
      <h1>{title}</h1>
      <p class="prose-meta blog-byline">
        {copy.blog.writtenBy}{" "}
        {author ? <a href={author.linkedin} rel="author">{author.name}</a> : copy.blog.authorPending}{" "}
        {copy.blog.on}{" "}
        {date ? <time datetime={iso(date)}>{formatDate(date)}</time> : copy.blog.datePending}.
        {updated && <> {copy.blog.updated} <time datetime={iso(updated)}>{formatDate(updated)}</time>.</>}
      </p>
      {image && <img class="blog-image" src={image} alt={imageAlt} width="1200" height="630" decoding="async" fetchpriority="high" />}
      <div class="blog-body"><BlogLinks><Content /></BlogLinks></div>
    </article>
    <div class="blog-cta">
      <p class="h3">{copy.blog.closing}</p>
      <p><a class="btn" href={copy.contact}>{copy.nav.cta}</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>
