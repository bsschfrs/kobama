---
// Eén blogartikel. Een artikel met `placeholder: true` is zichtbaar gemarkeerd
// (data-placeholder) zodat `npm run qa -- --launch` faalt tot het echt geschreven is.
// Echte artikelen krijgen een byline van een founder en BlogPosting structured data
// (Google Article-richtlijnen: auteur met url, datePublished en dateModified).
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import BlogLinks from "../../components/BlogLinks.astro";
import { copy } from "../../content/copy";
import { site } from "../../content/site";
import { formatDate, formatDateTime, getPosts, isScheduled } from "../../scripts/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, author: authorId, placeholder, image, imageAlt } = post.data;
const imagePng = image?.replace(/\.svg$/, ".png");
const author = copy.people.members.find((m) => m.id === authorId);
const iso = (d: Date) => d.toISOString().slice(0, 10);

const base = Astro.site ?? site.url;
const url = new URL(Astro.url.pathname, base).href;
const blogPosting = !placeholder && author && date
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      inLanguage: "nl-NL",
      mainEntityOfPage: url,
      url,
      datePublished: date.toISOString(),
      dateModified: (updated ?? date).toISOString(),
      image: new URL(imagePng ?? copy.meta.ogImage, base).href,
      author: { "@type": "Person", name: author.name, url: author.linkedin },
      publisher: {
        "@type": "Organization",
        name: site.name,
        url: site.url,
        logo: { "@type": "ImageObject", url: new URL("/images/logo-kobama.webp", base).href },
      },
    }
  : undefined;
---
<Base title={`${title} | KOBAMA`} description={description} ogType={placeholder ? "website" : "article"} extraJsonLd={blogPosting} ogImage={imagePng} ogImageAlt={imageAlt}>
  <a class="skip" href="#main">Naar de inhoud</a>
  <PageHeader />
  <main id="main" class="wrap prose blog-post">
    <p class="blog-back"><a href="/blog/">{copy.blog.back}</a></p>
    {isScheduled(post) && date && <p class="blog-scheduled">{copy.blog.scheduled} {formatDateTime(date)}</p>}
    <article data-placeholder={placeholder ? `blog/${post.id}` : undefined}>
      <h1>{title}</h1>
      <p class="prose-meta blog-byline">
        {copy.blog.writtenBy}{" "}
        {author ? <a href={author.linkedin} rel="author">{author.name}</a> : copy.blog.authorPending}{" "}
        {copy.blog.on}{" "}
        {date ? <time datetime={iso(date)}>{formatDate(date)}</time> : copy.blog.datePending}.
        {updated && <> {copy.blog.updated} <time datetime={iso(updated)}>{formatDate(updated)}</time>.</>}
      </p>
      {image && <img class="blog-image" src={image} alt={imageAlt} width="1200" height="630" decoding="async" fetchpriority="high" />}
      <div class="blog-body"><BlogLinks><Content /></BlogLinks></div>
    </article>
    <div class="blog-cta">
      <p class="h3">{copy.blog.closing}</p>
      <p><a class="btn" href={copy.contact}>{copy.nav.cta}</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>
